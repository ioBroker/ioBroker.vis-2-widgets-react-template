{
    "name": "iobroker.vis-2-widgets-react-template",
    "version": "1.3.1",
    "description": "ioBroker vis widget demo",
    "author": "bluefox <dogafox@gmail.com>",
    "contributors": [
        "bluefox <dogafox@gmail.com>"
    ],
    "engines": {
        "node": ">=22.19.0"
    },
    "homepage": "https://github.com/ioBroker/ioBroker.vis-2-widgets-react-template",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/ioBroker/ioBroker.vis-2-widgets-react-template"
    },
    "keywords": [
        "ioBroker",
        "visualization"
    ],
    "devDependencies": {
        "@alcalzone/release-script": "^5.2.1",
        "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
        "@alcalzone/release-script-plugin-license": "^5.2.2",
        "@iobroker/build-tools": "^3.0.3",
        "@iobroker/eslint-config": "^2.3.4",
        "@iobroker/types-vis-2": "~2.20.1",
        "@iobroker/vis-2-widgets-testing": "^2.0.0",
        "@types/node": "^26.4.1",
        "mocha": "^12.0.2",
        "tsx": "^4.21.1",
        "typescript": "~6.0.3"
    },
    "main": "widgets/vis-2-widgets-react-template/customWidgets.js",
    "files": [
        "admin/",
        "widgets/",
        "io-package.json",
        "LICENSE"
    ],
    "scripts": {
        "prepublishOnly": "tsx tasks.ts",
        "check": "tsc",
        "lint": "eslint -c eslint.config.mjs tasks.ts && cd src-widgets-ts && eslint -c eslint.config.mjs",
        "lint-jsv": "cd src-widgets-jsvite && eslint -c eslint.config.mjs",
        "build": "tsx tasks.ts --typescript",
        "build-ts": "tsx tasks.ts --typescript",
        "build-jsv": "tsx tasks.ts --javascript-vite",
        "release": "release-script",
        "release-patch": "release-script patch --yes",
        "release-minor": "release-script minor --yes",
        "release-major": "release-script major --yes",
        "test": "mocha ./test/*.test.js",
        "update-packages": "npx -y npm-check-updates --upgrade && cd src-widgets-ts && npx -y npm-check-updates --upgrade && cd ../src-widgets-jsvite && npx -y npm-check-updates --upgrade",
        "npm": "npm i && cd src-widgets-ts && npm i && cd ../src-widgets-jsvite && npm i"
    },
    "bugs": {
        "url": "https://github.com/ioBroker/ioBroker.vis-2-widgets-react-template/issues"
    },
    "readmeFilename": "README.md"
}
